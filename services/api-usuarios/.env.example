APP_NAME=api-usuarios
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# En docker compose estas variables las define docker-compose.yml
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=usuarios
DB_USERNAME=usuarios
DB_PASSWORD=usuarios

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT RS256 (php artisan jwt:claves genera las claves en JWT_KEYS_PATH)
# JWT_KEYS_PATH=/ruta/absoluta   (por defecto storage/keys)
JWT_KID=colcatrufis-1
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# BD del monolito, para usuarios:migrar-monolito
MONOLITO_DB_HOST=127.0.0.1
MONOLITO_DB_PORT=3306
MONOLITO_DB_DATABASE=colcatrufis
MONOLITO_DB_USERNAME=root
MONOLITO_DB_PASSWORD=
