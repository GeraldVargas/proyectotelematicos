APP_NAME=api-notificaciones
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# En docker compose estas variables las define docker-compose.yml
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=notificaciones
DB_USERNAME=notificaciones
DB_PASSWORD=notificaciones

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

EVENTOS_COLA=colcatrufis:eventos

# Push. Local: FCM_URL=http://fcm-mock:8080. Real: FCM_URL=https://fcm.googleapis.com y FCM_CREDENCIALES
# con la ruta al JSON de la cuenta de servicio. Sin ninguna de las dos, el push queda apagado.
FCM_URL=
FCM_PROJECT_ID=colcatrufis-local
FCM_CREDENCIALES=
