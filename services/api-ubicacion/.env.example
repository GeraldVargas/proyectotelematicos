APP_NAME=api-ubicacion
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# En docker compose estas variables las define docker-compose.yml
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ubicacion
DB_USERNAME=ubicacion
DB_PASSWORD=ubicacion

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

EVENTOS_COLA=colcatrufis:eventos

# BD del monolito, para ubicacion:migrar-monolito
MONOLITO_DB_HOST=127.0.0.1
MONOLITO_DB_PORT=3306
MONOLITO_DB_DATABASE=colcatrufis
MONOLITO_DB_USERNAME=root
MONOLITO_DB_PASSWORD=
